{
  "name": "cinewatch-tv",
  "version": "0.0.0",
  "private": true,
  "description": "CineWatch TV V1 engineering workspace",
  "license": "UNLICENSED",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=12 <13"
  },
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "check:runtime": "bash scripts/check_runtime.sh",
    "check:tree": "python scripts/check_repository_tree.py",
    "test:repository": "python -m unittest discover -s tests/repository -p 'test_*.py'",
    "check": "npm run check:tree && npm run check:frontend && npm run test:repository",
    "check:frontend": "python scripts/check_frontend_skeleton.py",
    "dev:web": "npm run dev -w @cinewatch/web",
    "build:web": "npm run build -w @cinewatch/web",
    "lint:web": "npm run lint -w @cinewatch/web",
    "typecheck:web": "npm run typecheck -w @cinewatch/web"
  }
}
