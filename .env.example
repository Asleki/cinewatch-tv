# CineWatch TV V1
#
# This file contains public variable names and non-secret local defaults only.
# Never place real credentials in this file.

CINEWATCH_ENV=local
CINEWATCH_APP_NAME="CineWatch TV"
CINEWATCH_SERVICE_NAME=cinewatch-api
CINEWATCH_LOG_LEVEL=INFO

# CineWatch-owned PostgreSQL authority. CWTV.V1.2.5 consumes this only when
# a database operation or migration is explicitly invoked.
# Development database identity: cinewatch_dev
# Example shape only; never commit real credentials:
# DATABASE_URL=postgresql+psycopg://cinewatch_app:CHANGE_ME@127.0.0.1:5432/cinewatch_dev
DATABASE_URL=

# Reserved external-provider credentials. Keep blank in Git.
TMDB_API_KEY=
YOUTUBE_API_KEY=

# MusicBrainz requires a meaningful application User-Agent when that provider is introduced.
MUSICBRAINZ_USER_AGENT=

# Future AWS/Cognito configuration is added only after the owning milestone is qualified.

# Public CineWatch web configuration. These values are browser-visible and must never contain secrets.
NEXT_PUBLIC_CINEWATCH_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CINEWATCH_SITE_URL=http://127.0.0.1:3000
