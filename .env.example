# CineWatch TV V1
#
# This file defines names only. Never place real credentials in this file.
# Exact runtime variables are finalized in CWTV.V1.2 and later infrastructure milestones.

CINEWATCH_ENV=local
CINEWATCH_APP_NAME="CineWatch TV"

# Reserved for the future CineWatch PostgreSQL authority.
DATABASE_URL=

# Reserved external-provider credentials. Keep blank in Git.
TMDB_API_KEY=
YOUTUBE_API_KEY=

# MusicBrainz requires a meaningful application User-Agent.
MUSICBRAINZ_USER_AGENT=

# Future AWS/Cognito configuration is added only after the AWS foundation is qualified.
