# Normalize repository text to LF across Android, Linux, macOS, and Windows.
* text=auto eol=lf

# Treat common binary formats as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
