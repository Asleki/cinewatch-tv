# CineWatch TV non-secret PostgreSQL session profile.
# Copy manually to ~/.config/cinewatch/postgres.env only after cinewatch_dev
# cloud PostgreSQL is actually provisioned.
#
# Passwords DO NOT belong in this file. Use ~/.pgpass with chmod 600.

PGHOST=<cinewatch-rds-host>
PGPORT=5432
PGDATABASE=cinewatch_dev
PGUSER=<cinewatch-db-user>
PGSSLMODE=require
PGCONNECT_TIMEOUT=30
