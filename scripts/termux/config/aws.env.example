# CineWatch TV non-secret AWS session profile.
# Copy manually to ~/.config/cinewatch/aws.env after the named AWS profile exists.
#
# Access keys, secret keys and session tokens DO NOT belong in this file.
# Store AWS credentials through the AWS CLI/profile mechanism.

AWS_PROFILE=cinewatch-dev
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
